# Optional. Stub mode needs no key and is the default for all reported metrics.
ANTHROPIC_API_KEY=

# stub | live — stub is $0 and deterministic; live uses a Haiku-class model.
ADVISOR_MODE=stub

# Daily spend cap for live mode (USD). Stub mode ignores this.
ADVISOR_DAILY_SPEND_CAP_USD=1.00

# SQLite path by default. Set DATABASE_URL=postgresql://... only if you wire Postgres.
ADVISOR_DB_PATH=data/advisor.db
# DATABASE_URL=
